{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Issuer": "your-issuer",
    "Audience": "your-audience",
    "Signingkey": "your-jwt-signing-key"
  },
  "ConnectionStrings": {
    "DefaultConnection": "your-database-connection-string"
  },
  "ReactApp": "your-react-app-url",
  "profiles": {
    "IIS Express": {
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "your-application-url",
      "sslPort": 0
    },
    "ProjectName": {
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "your-application-url",
      "sslPort": 0
    }
  },
  "EmailSettings": {
    "SmtpServer": "your-smtp-server",
    "SmtpPort": 587,
    "SenderName": "your-sender-name",
    "SenderEmail": "your-sender-email",
    "SenderPassword": "your-sender-password"
  },
  "Vnpay": {
    "TmnCode": "your-vnpay-tmn-code",
    "HashSecret": "your-vnpay-hash-secret",
    "BaseUrl": "your-vnpay-base-url",
    "Command": "pay",
    "CurrCode": "VND",
    "Version": "2.1.0",
    "Locale": "vn",
    "PaymentBackReturnUrl": "your-vnpay-payment-callback-url"
  },
  "PayOS": {
    "Client_id": "your-payos-client-id",
    "API_Key": "your-payos-api-key",
    "Checksum_Key": "your-payos-checksum-key",
    "Cancel_url": "your-payos-cancel-url",
    "Return_url": "your-payos-return-url"
  },
  "CloudinarySettings": {
    "CloudName": "your-cloudinary-cloud-name",
    "ApiKey": "your-cloudinary-api-key",
    "ApiSecret": "your-cloudinary-api-secret"
  },
  "TimeZoneId": "SE Asia Standard Time"
}